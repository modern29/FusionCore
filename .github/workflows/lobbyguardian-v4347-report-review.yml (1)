        Path('/tmp/guardian-4342-patch.py').write_bytes(zlib.decompress(base64.b64decode('')))
        subprocess.run(['python3','/tmp/guardian-4342-patch.py'],check=True)
        PY_END_4342
        dotnet build LobbyGuardian/LobbyGuardian.Plugin.csproj --configuration Release --no-restore
        python3 - <<'PY_REBUNDLE_END_4342'
        from pathlib import Path
        import zipfile,os
        asset=Path('fusionApp/src/main/assets/BepInEx-arm64.zip')
        dll=Path('LobbyGuardian/bin/Release/net10.0/LobbyGuardian.Plugin.dll')
