name: Lobby Guardian v4.3.47 - Public Lobby Bot and Report Review
'on':
  push:
    paths:
    - .github/workflows/lobbyguardian-v4347-report-review.yml
  workflow_dispatch: null
permissions:
  contents: read
jobs:
  android:
    runs-on: ubuntu-latest
    timeout-minutes: 100
    steps:
    - name: Checkout FusionCore
      uses: actions/checkout@v4
    - name: Java 17
      uses: actions/setup-java@v4
      with:
        distribution: temurin
        java-version: '17'
    - name: .NET 10
      uses: actions/setup-dotnet@v4
      with:
        dotnet-version: 10.0.x
    - name: Gradle
      uses: gradle/actions/setup-gradle@v4
    - name: Install PyYAML
      run: python3 -m pip install --user PyYAML
    - name: Recreate v4.3.38 source stages without oversized Bash arguments
      shell: bash
      run: |
        python3 - <<'PY_BASELINE'
        from pathlib import Path
        import subprocess,yaml,tempfile
        source=Path('.github/workflows/lobbyguardian-v4338-fix-ghost-chat-alwayschat-ghosts-vents-spoof.yml')
        assert source.is_file(), 'Previous successful v4.3.38 workflow not found'
        old=yaml.safe_load(source.read_text(encoding='utf8'))
        steps=old['jobs']['android']['steps']
        assert sum(s.get('name')=='Build v4.3.38 Android candidate APK' for s in steps)==1
        count=0
        for step in steps:
            name=step.get('name','')
            if name=='Build v4.3.38 Android candidate APK':break
            if not step.get('run') or name=='Install PyYAML':continue
            print('>>> BASELINE '+name,flush=True)
            with tempfile.NamedTemporaryFile(mode='w',encoding='utf8',suffix='.sh',delete=False) as temp:
                temp.write(step['run'])
                script_file=temp.name
            try:
                subprocess.run(['bash','-eo','pipefail',script_file],check=True)
            finally:
                Path(script_file).unlink(missing_ok=True)
            count+=1
        assert count>=18, 'Not enough source stages were reproduced'
        print('Recreated v4.3.38 game and Android sources from the pinned successful workflow:',count,'stages')
        PY_BASELINE
    - name: Fix GameCode resolver, name-on-join and Android copy-on-exit
      shell: bash
      run: |
        python3 - <<'PY_PATCH'
        from pathlib import Path
        import zlib,base64,subprocess
        s=""
        file=Path('/tmp/patch_guardian_4339.py')
        file.write_bytes(zlib.decompress(base64.b64decode(s)))
        subprocess.run(['python3',str(file)],check=True)
        PY_PATCH
        dotnet build LobbyGuardian/LobbyGuardian.Plugin.csproj --configuration Release --no-restore
        python3 - <<'PY_DLL'
        from pathlib import Path
        import os,zipfile
        asset=Path('fusionApp/src/main/assets/BepInEx-arm64.zip')
        dll=Path('LobbyGuardian/bin/Release/net10.0/LobbyGuardian.Plugin.dll')
        assert asset.is_file() and dll.is_file(), 'Compiled plugin or bundled BepInEx runtime missing'
        temp=asset.with_suffix('.code4339.zip')
        with zipfile.ZipFile(asset) as old,zipfile.ZipFile(temp,'w') as fresh:
            prefix=next((n[:-len('core/BepInEx.Core.dll')] for n in old.namelist() if n.endswith('core/BepInEx.Core.dll')),None)
            assert prefix is not None, 'BepInEx core missing'
            target=prefix+'plugins/LobbyGuardian.Plugin.dll'
            for entry in old.infolist():
                if entry.filename!=target:fresh.writestr(entry,old.read(entry.filename))
            fresh.write(dll,target,compress_type=zipfile.ZIP_DEFLATED)
        os.replace(temp,asset)
        print('Lobby Guardian 4.3.39 game/plugin and Android native clipboard bridge bundled')
        PY_DLL
    - name: Add selective host-only anti-flood defense, disconnect incident recorder, original Guardian controls and local
        self-test
      shell: bash
      run: |
        python3 - <<'PY_REPAIR_4340'
        import zlib,base64,pathlib,subprocess
        root=pathlib.Path('/tmp/guardian4340')
        root.mkdir(parents=True,exist_ok=True)
        (root/'HostResilienceShield.cs').write_bytes(zlib.decompress(base64.b64decode("")))
        (root/'patch.py').write_bytes(zlib.decompress(base64.b64decode("")))
        subprocess.run(['python3',str(root/'patch.py')],check=True)
        PY_REPAIR_4340
        dotnet build LobbyGuardian/LobbyGuardian.Plugin.csproj --configuration Release --no-restore
        python3 - <<'PY_REBUNDLE_4340'
        import zipfile,os
        from pathlib import Path
        asset=Path('fusionApp/src/main/assets/BepInEx-arm64.zip')
        dll=Path('LobbyGuardian/bin/Release/net10.0/LobbyGuardian.Plugin.dll')
        assert asset.is_file() and dll.is_file(),'Patched host defense DLL or runtime missing'
        with zipfile.ZipFile(asset) as original:
            prefix=next((x[:-len('core/BepInEx.Core.dll')] for x in original.namelist() if x.endswith('core/BepInEx.Core.dll')),None)
