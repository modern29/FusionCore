            for item in original.infolist():
                if item.filename!=target: updated.writestr(item,original.read(item.filename))
            updated.write(dll,target,compress_type=zipfile.ZIP_DEFLATED)
        os.replace(replacement,asset)
        print('v4.3.42 game-side host end logic bundled; v4.3.41 name, chat and host-start fixes retained')
        PY_REBUNDLE_END_4342
    - name: Fix actual chat visibility and Start button-state API; add opt-in host RPC signature auto-ban
      shell: bash
      run: |
        python3 - <<'PY_PREP_4343'
        import base64,zlib,pathlib
        p=pathlib.Path('/tmp/guardian4343');p.mkdir(parents=True,exist_ok=True)
        (p/'RpcAutoBanGuard.cs').write_bytes(zlib.decompress(base64.b64decode('')))
        (p/'patch.py').write_bytes(zlib.decompress(base64.b64decode('')))
        PY_PREP_4343
        python3 /tmp/guardian4343/patch.py
        dotnet build LobbyGuardian/LobbyGuardian.Plugin.csproj --configuration Release --no-restore
        python3 - <<'PY_PACKAGE_4343'
        from pathlib import Path
        import os,zipfile
        asset=Path('fusionApp/src/main/assets/BepInEx-arm64.zip')
        dll=Path('LobbyGuardian/bin/Release/net10.0/LobbyGuardian.Plugin.dll')
        assert asset.is_file() and dll.is_file(),'Missing Android game runtime or rebuilt plugin DLL'
        replacement=asset.with_name('guardian4343-bepinex.zip')
        with zipfile.ZipFile(asset) as old,zipfile.ZipFile(replacement,'w') as new:
            prefix=next((n[:-len('core/BepInEx.Core.dll')] for n in old.namelist() if n.endswith('core/BepInEx.Core.dll')),None)
            assert prefix is not None,'Missing BepInEx core in embedded runtime'
            target=prefix+'plugins/LobbyGuardian.Plugin.dll'
            for i in old.infolist():
                if i.filename!=target:new.writestr(i,old.read(i.filename))
            new.write(dll,target,compress_type=zipfile.ZIP_DEFLATED)
        os.replace(replacement,asset)
        print('v4.3.43 game module compiled and bundled, without altering exit clipboard or host-end feature')
        PY_PACKAGE_4343
    - name: Add host connection bot shield, session rejoin tracker and RPC flood protection
      shell: bash
      run: |
        mkdir -p /tmp/guardian4345
        cat > /tmp/guardian4345/ConnectionBotGuard.cs <<'CS_4345'
        using System;
        using System.Collections.Generic;
        using System.Diagnostics;
        using System.IO;
        using System.Linq;
        using System.Reflection;
        using System.Text.Json;
        using BepInEx;

        namespace LobbyGuardian;

        // Host-side lobby admission and traffic monitoring. No forged packets or sender claims.
        internal static class ConnectionBotGuard
        {
            const BindingFlags F=BindingFlags.Public|BindingFlags.NonPublic|BindingFlags.Instance|BindingFlags.Static;
            static readonly HashSet<byte> Listed=new(){85,101,133,201,202,250};
            static readonly HashSet<string> Names=new(){"CheckName","SetName","CheckColor","SetColor","SetHatStr","SetSkinStr","SetPetStr","SetVisorStr","SetNamePlateStr","SetLevel"};
            static readonly Dictionary<byte,string> Mapped=new();
            static readonly HashSet<byte> VanillaIds=new();
            static readonly HashSet<byte> Learned=new();
            static readonly Dictionary<byte,HashSet<string>> Evidence=new();
            sealed class Traffic { public readonly Queue<long> Handshake=new(), Cosmetic=new(); public readonly Dictionary<byte,RpcBurst> Custom=new(); public long LastSeen, LastVanillaFlag; public int VanillaFlags; }
            sealed class RpcBurst { public readonly Queue<long> Calls=new(); public long LastFlag; public int Flags; }
            sealed class Identity { public readonly Queue<long> Cycles=new(); public long LastSeen; public bool Blocked; }
            sealed class Arrival { public int Id; public string[] Keys=Array.Empty<string>(); public long At; public object? Data; public bool MissingPuid; public string Reason=""; public readonly Dictionary<byte,int> Calls=new(); }
            static readonly Dictionary<int,Traffic> TrafficByClient=new();
            static readonly Dictionary<string,Identity> Identities=new(StringComparer.OrdinalIgnoreCase);
            static readonly Dictionary<int,Arrival> Active=new();
            static readonly Dictionary<int,Arrival> Pending=new();
            static readonly Dictionary<string,long> Surge=new(StringComparer.OrdinalIgnoreCase);
            static readonly HashSet<int> BanRequested=new();
            static long _configAt,_statusAt,_surgeAt,_lastPrune,_mapAt;
            static int _room,_joins,_leaves,_missing,_surges,_missingBans,_rpcFlags,_bans,_listedObserved;
            static bool _host,_record=true,_banRejoin,_banMissing,_banListed,_banVanilla;
            static bool _reportReview=true;
            sealed class Review { public string atUtc {get;set;}=""; public string name {get;set;}=""; public string friendCode {get;set;}=""; public string reason {get;set;}=""; public int clientId {get;set;} }
            static readonly List<Review> ReportReview=new();
            static readonly HashSet<string> ReviewedKeys=new(StringComparer.OrdinalIgnoreCase);
            static void QueueReview(Arrival a){try{
                if(!_reportReview||a.Keys.Length==0||ExemptArrival(a)||ReportReview.Count>=30)return;
                string key=a.Keys.FirstOrDefault(k=>k.StartsWith("p:"))??a.Keys[0];
                if(!ReviewedKeys.Add(key))return;
                var fc=a.Keys.FirstOrDefault(k=>k.StartsWith("f:"));
                ReportReview.Add(new Review{atUtc=DateTimeOffset.UtcNow.ToString("O"),name=Str(Read(a.Data,"PlayerName")??Read(a.Data,"Name")),friendCode=fc==null?"":fc.Substring(2),clientId=a.Id,reason="Four completed rapid join/leave cycles within six seconds; suspected automation, not proof."});
            }catch{}}
            static string _last="Waiting for hosted lobby",_hooks="not registered";
            static long Now()=>Stopwatch.GetTimestamp();
            static long Ms(int n)=>Math.Max(1,n*Stopwatch.Frequency/1000);
            static object? Read(object? o,string key){try{if(o==null)return null;var t=o is Type ty?ty:o.GetType();var r=o is Type?null:o;return t.GetProperty(key,F)?.GetValue(r)??t.GetField(key,F)?.GetValue(r);}catch{return null;}}
            static int Num(object? o,int fallback=-1)=>int.TryParse(o?.ToString(),out int n)?n:fallback;
            static string Str(object? o)=>o?.ToString()?.Trim()??"";
            static string At(string n)=>Path.Combine(Paths.ConfigPath,n);
            static void Refresh(long now){if(now<_configAt)return;_configAt=now+Ms(1000);try{using var d=JsonDocument.Parse(File.ReadAllText(At("LobbyGuardian-utility-options.json")));var r=d.RootElement;
                bool On(string k)=>r.TryGetProperty(k,out var x)&&x.ValueKind==JsonValueKind.True;
                _record=!r.TryGetProperty("RecordConnectionBotActivity",out var x)||x.ValueKind!=JsonValueKind.False;
                _banRejoin=!r.TryGetProperty("AutoBanRapidRejoin",out var rr)||rr.ValueKind==JsonValueKind.True;
                _banMissing=!r.TryGetProperty("AutoBanMissingPuid",out var mp)||mp.ValueKind==JsonValueKind.True;
                _banListed=!r.TryGetProperty("AutoBanListedRpcFlood",out var lr)||lr.ValueKind==JsonValueKind.True;_banVanilla=On("AutoBanVanillaRpcFlood");_reportReview=!r.TryGetProperty("AutoPrepareBotReports",out var ar)||ar.ValueKind!=JsonValueKind.False;
            }catch{_record=true;_banRejoin=_banMissing=_banListed=true;_banVanilla=false;_reportReview=true;}}
            static bool Ready(){bool host=GameBridge.IsHost();int room=Num(Read(GameBridge.Client,"GameId"),0);string state=Str(Read(GameBridge.Client,"GameState"));
                if(host!=_host||room!=_room){_host=host;_room=room;Active.Clear();Pending.Clear();Identities.Clear();Surge.Clear();TrafficByClient.Clear();BanRequested.Clear();Learned.Clear();Evidence.Clear();ReportReview.Clear();ReviewedKeys.Clear();_surgeAt=0;_joins=_leaves=_missing=_surges=_missingBans=_rpcFlags=_bans=_listedObserved=0;}
                return host&&room!=0&&(state.Equals("Joined",StringComparison.OrdinalIgnoreCase)||state.Equals("Lobby",StringComparison.OrdinalIgnoreCase)||state=="1");}
            static bool Enabled()=>_record||_banRejoin||_banMissing||_banListed||_banVanilla||_reportReview;
            static bool Remote(int id)=>id>=0&&id!=Num(Read(GameBridge.Client,"ClientId"))&&id!=Num(Read(GameBridge.Client,"HostId"));
            static void Trim(Queue<long> q,long now,int ms){while(q.Count>0&&now-q.Peek()>=Ms(ms))q.Dequeue();}
            static void Add(Queue<long> q,long now,int ms){Trim(q,now,ms);if(q.Count<256)q.Enqueue(now);}
            static string[] Keys(object data){var fc=Str(Read(data,"FriendCode"));var puid=Str(Read(data,"ProductUserId")??Read(data,"Puid")??Read(data,"ProductUserID"));var keys=new List<string>(2);
                if(fc.Length>=3&&fc.Length<=128&&fc.Contains('#')&&!fc.Any(char.IsWhiteSpace))keys.Add("f:"+fc);
                if(puid.Length>=8&&puid.Length<=128&&!puid.Any(char.IsWhiteSpace)&&puid.Any(c=>c!='0'))keys.Add("p:"+puid);
                return keys.ToArray();}
            static bool MissingPuid(object data){try{var t=data.GetType();foreach(string key in new[]{"ProductUserId","Puid","ProductUserID"}){var prop=t.GetProperty(key,F);var field=t.GetField(key,F);if(prop==null&&field==null)continue;var value=prop!=null?prop.GetValue(data):field!.GetValue(data);return string.IsNullOrWhiteSpace(value?.ToString());}}catch{}return false;}
            static bool ExemptArrival(Arrival a){try{var r=RuleStore.LoadOrCreate(At("LobbyGuardian-rules.json"));var name=Str(Read(a.Data,"PlayerName")??Read(a.Data,"Name"));return r.AllowFriendCodes.Any(x=>x.Length>0&&a.Keys.Contains("f:"+x,StringComparer.OrdinalIgnoreCase))||r.AllowPuids.Any(x=>x.Length>0&&a.Keys.Contains("p:"+x,StringComparer.OrdinalIgnoreCase))||r.AllowNamesExact.Any(x=>x.Length>0&&(name.Length==0||x.Equals(name,StringComparison.OrdinalIgnoreCase)));}catch{return true;}}
            static bool BanArrival(Arrival a){try{
                if(!Ready()||!Remote(a.Id)||!Active.TryGetValue(a.Id,out var current)||!ReferenceEquals(current,a))return false;
                if(BanRequested.Contains(a.Id))return true;
                if(a.Reason=="Missing PUID"&&(!a.MissingPuid||a.Data==null||!MissingPuid(a.Data)))return true;
                var players=GameBridge.ReadConnectedPlayers().Where(p=>p.ClientId==a.Id&&!p.IsHost&&!p.IsLocal).Take(2).ToArray();
                if(players.Length>1)return false;
                if(players.Length==1){var p=players[0];if(Exempt(p)||ExemptArrival(a))return true;
                    if(a.Reason=="Missing PUID"&&!string.IsNullOrWhiteSpace(p.Puid))return true;
                    if(a.Reason!="Missing PUID"&&!a.Keys.Any(k=>k.Equals("f:"+p.FriendCode,StringComparison.OrdinalIgnoreCase)||k.Equals("p:"+p.Puid,StringComparison.OrdinalIgnoreCase)))return false;
                    if(GameBridge.Ban(p)){BanRequested.Add(a.Id);_bans++;if(a.Reason=="Missing PUID")_missingBans++;_last=a.Reason+"; host ban requested";HostExtras.ModerationNotice("ban",p,a.Reason,true);return true;}}
                // A valid connection callback supplies the client ID before PlayerControl spawns.
                // Use only the ordinary host kick/ban method, never fabricate a packet.
                if(ExemptArrival(a))return true;
                var c=GameBridge.Client;if(c==null)return false;
                var method=c.GetType().GetMethods(F).FirstOrDefault(m=>m.Name=="KickPlayer"&&!m.IsStatic&&m.GetParameters().Length==2&&m.GetParameters()[0].ParameterType==typeof(int)&&m.GetParameters()[1].ParameterType==typeof(bool));
                if(method==null){_last="Early host ban API unavailable; retrying connected player lookup";return false;}
                BanRequested.Add(a.Id);try{var result=method.Invoke(c,new object[]{a.Id,true});if(result is bool ok&&!ok){BanRequested.Remove(a.Id);return false;}}catch{BanRequested.Remove(a.Id);return false;}
                _bans++;if(a.Reason=="Missing PUID")_missingBans++;_last=a.Reason+"; early host ban requested (server outcome unverified)";return true;
            }catch{return false;}}
            static void Learn(Arrival a){if(VanillaIds.Count==0||a.Keys.Length==0)return;string key=a.Keys.FirstOrDefault(k=>k.StartsWith("p:"))??a.Keys[0];
                foreach(var pair in a.Calls){if(pair.Value<3||VanillaIds.Contains(pair.Key)||Listed.Contains(pair.Key))continue;
                    if(!Evidence.TryGetValue(pair.Key,out var peers))Evidence[pair.Key]=peers=new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                    if(peers.Count<32)peers.Add(key);
                    if(peers.Count>=2)Learned.Add(pair.Key);}}
            static Identity? Track(string key,long now){if(!Identities.TryGetValue(key,out var v)){if(Identities.Count>=256)return null;Identities[key]=v=new Identity();}v.LastSeen=now;Trim(v.Cycles,now,6000);return v;}
            static bool Exempt(PlayerIdentity p){try{var r=RuleStore.LoadOrCreate(At("LobbyGuardian-rules.json"));return r.AllowFriendCodes.Any(x=>x.Length>0&&x.Equals(p.FriendCode,StringComparison.OrdinalIgnoreCase))||r.AllowPuids.Any(x=>x.Length>0&&x.Equals(p.Puid,StringComparison.OrdinalIgnoreCase))||r.AllowNamesExact.Any(x=>x.Length>0&&x.Equals(p.Name,StringComparison.OrdinalIgnoreCase));}catch{return true;}}
            static bool Ban(int id,string reason,string[]? keys=null){if(!Ready()||!Remote(id)||BanRequested.Contains(id))return false;
                var players=GameBridge.ReadConnectedPlayers().Where(p=>p.ClientId==id&&!p.IsLocal&&!p.IsHost).Take(2).ToArray();if(players.Length!=1)return false;var p=players[0];
                if(keys!=null&&!keys.Any(k=>k.Equals("f:"+p.FriendCode,StringComparison.OrdinalIgnoreCase)||k.Equals("p:"+p.Puid,StringComparison.OrdinalIgnoreCase)))return false;
                if(Exempt(p)){_last="Allowlist exemption: "+reason;return true;}BanRequested.Add(id);bool sent=GameBridge.Ban(p);if(sent)_bans++;_last=reason+(sent?"; host ban requested":"; ban unavailable");HostExtras.ModerationNotice("ban",p,reason,sent);return true;}
            internal static void Hooks(string message)=>_hooks=message;
            internal static void Joined(object? data){try{long now=Now();Refresh(now);if(data==null||!Ready()||!Enabled())return;int id=Num(Read(data,"Id")??Read(data,"ClientId"));if(!Remote(id)||Active.ContainsKey(id)||Active.Count>=64)return;
                var keys=Keys(data);var a=new Arrival{Id=id,Keys=keys,At=now,Data=data,MissingPuid=MissingPuid(data)};Active[id]=a;BanRequested.Remove(id);TrafficByClient.Remove(id);_joins++;
                if(keys.Length<2){_missing++;_last="Join with missing/unvalidated friend code or PUID";}
                if(a.MissingPuid&&_banMissing){a.Reason="Missing PUID";Pending[id]=a;}
                foreach(var key in keys){var v=Track(key,now);if(v!=null&&(v.Blocked||v.Cycles.Count>=4)&&_banRejoin){v.Blocked=true;a.Reason="Rapid rejoin session block";Pending[id]=a;}}
                foreach(var old in Surge.Where(x=>now-x.Value>=Ms(2000)).Select(x=>x.Key).ToArray())Surge.Remove(old);
                string surgeKey=keys.FirstOrDefault(k=>k.StartsWith("p:"))??keys.FirstOrDefault()??("id:"+id);Surge[surgeKey]=now;
                if(Surge.Count>=4&&now>=_surgeAt){_surgeAt=now+Ms(2000);_surges++;_last="Join surge: public lobby retained; only individually flagged connections eligible";}
                if(Pending.ContainsKey(id)&&BanArrival(a))Pending.Remove(id);
            }catch(Exception e){_last="Join observer: "+e.GetBaseException().GetType().Name;}}
            internal static void Left(object? data){try{long now=Now();Refresh(now);if(data==null||!Ready()||!Enabled())return;int id=Num(Read(data,"Id")??Read(data,"ClientId"));if(!Active.TryGetValue(id,out var a))return;Active.Remove(id);Pending.Remove(id);TrafficByClient.Remove(id);BanRequested.Remove(id);_leaves++;
                bool confirmed=false;
