        replacement=asset.with_name('guardian4342-bepinex.zip')
        with zipfile.ZipFile(asset) as original, zipfile.ZipFile(replacement,'w') as updated:
            prefix=next((n[:-len('core/BepInEx.Core.dll')] for n in original.namelist() if n.endswith('core/BepInEx.Core.dll')),None)
            assert prefix is not None,'Embedded BepInEx runtime missing'
